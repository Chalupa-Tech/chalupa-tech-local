{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "America/Denver",
  "schedule": [
    "after 5am and before 9am every weekday"
  ],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "ignorePaths": [
    "**/.worktrees/**",
    "pulumi/.go_cache/**",
    "pulumi/.go_mod_cache/**"
  ],
  "enabledManagers": [
    "gomod",
    "github-actions",
    "helmv3",
    "terraform",
    "custom.regex"
  ],
  "postUpdateOptions": [
    "helmUpdateSubChartArchives",
    "gomodTidy"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images in Helm values (repository/tag pairs, tolerating comment lines between them)",
      "managerFilePatterns": [
        "/gitops/apps/.+/values\\.ya?ml$/"
      ],
      "matchStrings": [
        "repository:\\s+(?<depName>[^\\s\"'#]+)[^\\n]*\\n(?:\\s*#[^\\n]*\\n)*\\s*tag:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "CloudNativePG postgres image (single-line imageName: repo:tag)",
      "managerFilePatterns": [
        "/gitops/apps/media/arrs-pg/values\\.yaml$/"
      ],
      "matchStrings": [
        "imageName:\\s+[\"']?(?<depName>[^:\\s\"']+):(?<currentValue>[^\\s\"']+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Talos Linux version (Pulumi Go const + Ansible var, kept in sync)",
      "managerFilePatterns": [
        "/pulumi-talos/main\\.go$/",
        "/ansible/roles/proxmox_prep/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "talosVersion\\s*=\\s*\"(?<currentValue>v[0-9.]+)\"",
        "proxmox_prep_talos_version:\\s*\"?(?<currentValue>v[0-9.]+)\"?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "siderolabs/talos"
    },
    {
      "customType": "regex",
      "description": "Kubernetes version pinned in Pulumi Talos machine-config generation",
      "managerFilePatterns": [
        "/pulumi-talos/main\\.go$/"
      ],
      "matchStrings": [
        "kubernetesVersion\\s*=\\s*\"(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes/kubernetes",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Home Assistant OS version (Pulumi config + Ansible var, kept in sync)",
      "managerFilePatterns": [
        "/pulumi/Pulumi\\.proxmox\\.yaml$/",
        "/ansible/group_vars/all\\.yml$/"
      ],
      "matchStrings": [
        "haosVersion:\\s*\"?(?<currentValue>[0-9.]+)\"?",
        "haos_version:\\s*\"?(?<currentValue>[0-9.]+)\"?"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "home-assistant/operating-system",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Proxmox provider version pinned in Pulumi provider setup",
      "managerFilePatterns": [
        "/pulumi/main\\.go$/",
        "/pulumi-talos/main\\.go$/"
      ],
      "matchStrings": [
        "pulumi\\.Version\\(\"(?<currentValue>[0-9.]+)\"\\)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "muhlba91/pulumi-proxmoxve",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Go toolchain version in workflows (keep in sync with go.mod)",
      "managerFilePatterns": [
        "/\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "go-version:\\s*[\"']?(?<currentValue>[0-9.]+)[\"']?"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "ArgoCD bootstrap chart version in deploy.yml Stage 4 (helm upgrade --install argocd argo/argo-cd --version X)",
      "managerFilePatterns": [
        "/\\.github/workflows/deploy\\.yml$/"
      ],
      "matchStrings": [
        "helm upgrade --install argocd argo/argo-cd \\\\\\n\\s+--namespace argocd --create-namespace \\\\\\n\\s+--version (?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "helm",
      "depNameTemplate": "argo-cd",
      "registryUrlTemplate": "https://argoproj.github.io/argo-helm"
    },
    {
      "customType": "regex",
      "description": "kubeconform release used by the gitops lint workflow",
      "managerFilePatterns": [
        "/\\.github/workflows/gitops\\.yml$/"
      ],
      "matchStrings": [
        "yannh/kubeconform/releases/download/(?<currentValue>v[0-9.]+)/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "yannh/kubeconform"
    },
    {
      "customType": "regex",
      "description": "yamllint pip pin in the gitops lint workflow",
      "managerFilePatterns": [
        "/\\.github/workflows/gitops\\.yml$/"
      ],
      "matchStrings": [
        "pip install yamllint==(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "yamllint"
    },
    {
      "customType": "regex",
      "description": "DepotDownloader release pinned for the Valheim server (tag DepotDownloader_X.Y.Z)",
      "managerFilePatterns": [
        "/oracle-cloud-server/ansible/roles/valheim/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "depotdownloader_version:\\s*\"(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "SteamRE/DepotDownloader",
      "extractVersionTemplate": "^DepotDownloader_(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Single-line container images in Helm values (image: repo:tag), e.g. init containers",
      "managerFilePatterns": [
        "/gitops/apps/.+/values\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\bimage:[ \\t]+[\"']?(?<depName>[a-z0-9][a-z0-9./-]*[a-z0-9]):(?<currentValue>v?[0-9][A-Za-z0-9._-]*)[\"']?[ \\t]*(?:#[^\\n]*)?\\n"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Renovate's own image (chart splits registry/repository/tag)",
      "managerFilePatterns": [
        "/gitops/apps/infra-tools/renovate/values\\.yaml$/"
      ],
      "matchStrings": [
        "repository:\\s+(?<repo>[^\\s\"']+)\\s*\\n\\s*registry:\\s+(?<registry>[^\\s\"']+)\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "{{registry}}/{{repo}}"
    },
    {
      "customType": "regex",
      "description": "OpenBao OCI KMS seal plugin (openbao-plugins release kms-oci-vX.Y.Z) pinned in the openbao chart values; the sha256 line below it must be updated by hand",
      "managerFilePatterns": [
        "/gitops/apps/platform/openbao/values\\.yaml$/"
      ],
      "matchStrings": [
        "version:\\s*\"(?<currentValue>[0-9.]+)\"\\s*\\n\\s*sha256:\\s*\"[0-9a-f]{64}\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "openbao/openbao-plugins",
      "extractVersionTemplate": "^kms-oci-v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "All major updates require manual approval via the Dependency Dashboard",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "linuxserver.io composite versioning (<upstream>-ls<build>)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^lscr\\.io\\/linuxserver\\//"
      ],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)(\\.(?<patch>\\d+))?(\\.(?<build>\\d+))?-ls(?<revision>\\d+)$"
    },
    {
      "description": "Images that only publish :latest \u2014 track by digest instead",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/frebib/nzbget-exporter"
      ],
      "pinDigests": true
    },
    {
      "description": "proxmoxve Go SDK + provider plugin pin must bump together (split PRs can never pass CI)",
      "matchPackageNames": [
        "github.com/muhlba91/pulumi-proxmoxve/sdk/v8",
        "muhlba91/pulumi-proxmoxve"
      ],
      "groupName": "pulumi-proxmoxve"
    },
    {
      "description": "Group the shared bjw-s app-template chart bump into one PR",
      "matchManagers": [
        "helmv3"
      ],
      "matchDepNames": [
        "app-template"
      ],
      "groupName": "media app-template"
    },
    {
      "description": "Platform-critical charts (incl. Renovate's own): minor = grouped Monday PR, no auto-merge",
      "matchManagers": [
        "helmv3"
      ],
      "matchFileNames": [
        "gitops/apps/platform/**",
        "gitops/apps/infra-tools/renovate/**"
      ],
      "groupName": "platform charts",
      "schedule": [
        "before 9am on monday"
      ],
      "automerge": false,
      "matchUpdateTypes": [
        "minor"
      ]
    },
    {
      "description": "Platform-critical charts: patch releases auto-merge (ArgoCD selfHeal applies; security fixes ship as patches)",
      "matchManagers": [
        "helmv3"
      ],
      "matchFileNames": [
        "gitops/apps/platform/**",
        "gitops/apps/infra-tools/renovate/**"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Auto-merge low-risk media/observability leaf images",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "gitops/apps/media/**",
        "gitops/apps/observability/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Auto-merge media/observability leaf chart minor + patch",
      "matchManagers": [
        "helmv3"
      ],
      "matchFileNames": [
        "gitops/apps/media/**",
        "gitops/apps/observability/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Auto-merge GitHub Actions minor + patch + digest",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Auto-merge Go module minor + patch",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "OVERRIDE \u2014 Pulumi Go SDKs are infra-critical: PR only",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "/pulumi/"
      ],
      "automerge": false
    },
    {
      "description": "Talos: patch auto-merges (Stage 2c rolls the nodes), minor = PR (manual merge), major needs approval",
      "matchDepNames": [
        "siderolabs/talos"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "platformAutomerge": true,
      "dependencyDashboardApproval": false
    },
    {
      "matchDepNames": [
        "siderolabs/talos"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false,
      "dependencyDashboardApproval": false
    },
    {
      "matchDepNames": [
        "siderolabs/talos"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Kubernetes: patch auto-merges (Stage 2c runs upgrade-k8s); minor/major need approval (Talos support matrix)",
      "matchDepNames": [
        "kubernetes/kubernetes"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "platformAutomerge": true,
      "dependencyDashboardApproval": false
    },
    {
      "matchDepNames": [
        "kubernetes/kubernetes"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "HAOS pin only affects fresh provisioning (the VM self-updates): minor/patch auto-merge",
      "matchDepNames": [
        "home-assistant/operating-system"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "platformAutomerge": true,
      "dependencyDashboardApproval": false
    },
    {
      "description": "Go toolchain and the Proxmox provider drive the reprovision pipeline: PR + approval only",
      "matchDepNames": [
        "muhlba91/pulumi-proxmoxve",
        "go"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Renovate's own image: minor/patch auto-merge, major needs approval (chart bumps never change it)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "OpenBao OCI KMS seal plugin: never auto-merge (sha256 pin + go-kms-wrapping#163 flag inversion need a human)",
      "matchDepNames": [
        "openbao/openbao-plugins"
      ],
      "automerge": false,
      "labels": [
        "openbao-plugin"
      ],
      "prBodyNotes": [
        "Before merging: (1) set `global.ociKms.plugin.sha256` to the `openbao-plugin-kms-oci_linux_amd64_v1.tar.gz` line of `checksums-kms-oci.txt` from the release; (2) check whether openbao/go-kms-wrapping#163 is fixed \u2014 if the plugin now pins a wrapper >= v2.4 with the fix, keep `auth_type_api_key = \"true\"`; if it pins the inverted wrapper, do not merge; (3) roll one pod (`kubectl -n openbao delete pod openbao-2`) and confirm it auto-unseals before the others."
      ]
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ]
  }
}
